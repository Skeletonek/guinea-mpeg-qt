[Desktop Entry]
Name=GuineaMPEG
Comment=FFmpeg GUI Frontend
Comment[cs]=Grafické rozhraní pro FFmpeg
Comment[de]=Grafische Oberfläche für FFmpeg
Comment[es]=Interfaz gráfica para FFmpeg
Comment[fr]=Interface graphique pour FFmpeg
Comment[it]=Interfaccia grafica per FFmpeg
Comment[pl]=Graficzny interfejs dla FFmpeg
Comment[ru]=Графический интерфейс для FFmpeg
GenericName=Media Transcoding Utility
GenericName[cs]=Nástroj pro překódování médií
GenericName[de]=Programm zur Medienkonvertierung
GenericName[es]=Utilidad de transcodificación de medios
GenericName[fr]=Outil de transcodage multimédia
GenericName[it]=Strumento di transcodifica multimediale
GenericName[pl]=Narzędzie do transkodowania multimediów
GenericName[ru]=Программа для транскодирования мультимедиа
Exec=/app/bin/guinea-mpeg %F
Icon=com.skeletonek.guinea-mpeg
Terminal=false
Type=Application
Categories=AudioVideo;AudioVideoEditing;
Keywords=ffmpeg;video;transcode;
Keywords[cs]=ffmpeg;video;překódování;
Keywords[de]=ffmpeg;Video;Transkodierung;
