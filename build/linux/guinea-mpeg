#!/bin/bash
# Launcher script for GuineaMPEG
# Locates and starts the binary regardless of install prefix.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Walk upwards to find lib/guinea-mpeg/libguinea_mpeg_core.so
SEARCH="$SCRIPT_DIR"
while [ "$SEARCH" != "/" ]; do
    LIBDIR="$SEARCH/lib/guinea-mpeg"
    if [ -d "$LIBDIR" ]; then
        break
    fi
    SEARCH="$(dirname "$SEARCH")"
done

if [ -d "$LIBDIR" ]; then
    export LD_LIBRARY_PATH="$LIBDIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

# Find the binary
if [ -x "$SCRIPT_DIR/guinea-mpeg" ]; then
    exec "$SCRIPT_DIR/guinea-mpeg" "$@"
elif [ -x "$SCRIPT_DIR/bin/guinea-mpeg" ]; then
    exec "$SCRIPT_DIR/bin/guinea-mpeg" "$@"
else
    echo "guinea-mpeg binary not found" >&2
    exit 1
fi
