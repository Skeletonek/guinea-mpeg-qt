#pragma code_page(65001)

#include <winver.h>

1 ICON "@APP_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @FILE_VERSION_TUPLE@
 PRODUCTVERSION @FILE_VERSION_TUPLE@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "@APP_PUBLISHER@"
            VALUE "FileDescription", "@APP_NAME@"
            VALUE "FileVersion", "@PROJECT_VERSION_FULL@"
            VALUE "InternalName", "@APP_EXE_NAME@"
            VALUE "LegalCopyright", "@APP_COPYRIGHT@"
            VALUE "OriginalFilename", "@APP_EXE_NAME@"
            VALUE "ProductName", "@APP_NAME@"
            VALUE "ProductVersion", "@PROJECT_VERSION_FULL@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
